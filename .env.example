# this is the server port
PORT=4000

# this is the environment
NODE_ENV=development

# this is the full Postgres connection string provided by Supabase
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# this is the direct connection string (same as above without pooling)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# this is the Supabase project URL
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# this is the Supabase service role key (server only, never expose to clients)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# this is the Supabase anon key (safe for clients)
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
