# this is the server port
PORT=4000

# this is the environment
NODE_ENV=development

# this is the Supabase pooled connection (used at runtime by Prisma Client)
DATABASE_URL="postgresql://postgres.rdpfgxlshjxfwzwieker:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# this is the Supabase direct connection (used for migrations by Prisma CLI)
DIRECT_URL="postgresql://postgres.rdpfgxlshjxfwzwieker:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# this is the Supabase project URL
SUPABASE_URL="https://rdpfgxlshjxfwzwieker.supabase.co"

# this is the Supabase service role key (server only, never expose to clients)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# this is the Supabase anon key (safe for clients)
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# this is the QStash URL for background jobs
QSTASH_URL="https://qstash-us-east-1.upstash.io"

# this is the QStash token (get it from the Upstash console)
QSTASH_TOKEN="[YOUR-QSTASH-TOKEN]"

# this is the current QStash signing key for verifying callback signatures
QSTASH_CURRENT_SIGNING_KEY="[YOUR-CURRENT-SIGNING-KEY]"

# this is the next QStash signing key (for key rotation)
QSTASH_NEXT_SIGNING_KEY="[YOUR-NEXT-SIGNING-KEY]"
